---
import Layout from "../layouts/Layout.astro";

const sarees = [
	{ src: "/images/Saree-02.jpg", alt: "Green Saree Collection" },
	{ src: "/images/Saree-01.jpg", alt: "Purple Saree Collection" },
	{ src: "/images/Saree-03.jpg", alt: "Red Saree Collection" },
	{ src: "/images/Saree-04.jpg", alt: "Cream Ethnic Collection" },
	{ src: "/images/Saree-05.jpg", alt: "Modern Prints Collection" },
];

const heroSlides = [
	{
		title: "Weaving Tradition<br/>with Innovation",
		sub: "Pioneering Modern Textile Artistry",
		img: "/images/young-indian-woman-wearing-sari-posing-historic-building-india.jpg",
	},
	{
		title: "Excellence in<br/>Every Thread",
		sub: "Crafting the Future of Heritage Textiles",
		img: "/images/hero/hero-purple.jpg",
	},
];
---

<Layout>
	<!-- SS2: Hero -->
	<section class="hero-section">
		<div class="hero-slides">
			{
				heroSlides.map((slide, i) => (
					<div
						class={`hero-slide ${i === 0 ? "active" : ""}`}
						data-index={i}
					>
						<div class="hero-bg">
							<img src={slide.img} alt={slide.sub} />
						</div>
						<div class="container hero-inner">
							<h1
								class="text-maroon"
								set:html={slide.title}
							/>
							<div class="hero-divider divider-white" />
							<p class="text-navy sub-heading">
								{slide.sub}
							</p>
						</div>
					</div>
				))
			}
		</div>
		<div class="hero-controls">
			<button class="nav-btn prev">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					><path d="M15 19l-7-7 7-7"></path></svg
				>
			</button>
			<button class="nav-btn next">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					><path d="M9 5l7 7-7 7"></path></svg
				>
			</button>
		</div>
	</section>

	<script>
		// 2. Hero Slider Logic
		const heroSection = document.querySelector(".hero-section");
		const slides = document.querySelectorAll(".hero-slide");
		const nextHero = document.querySelector(".hero-controls .next");
		const prevHero = document.querySelector(".hero-controls .prev");
		let heroIdx = 0;
		let touchStartX = 0;
		let touchEndX = 0;

		function updateHero(newIdx: number) {
			slides[heroIdx].classList.remove("active");
			heroIdx = (newIdx + slides.length) % slides.length;
			slides[heroIdx].classList.add("active");
		}

		nextHero?.addEventListener("click", () =>
			updateHero(heroIdx + 1),
		);
		prevHero?.addEventListener("click", () =>
			updateHero(heroIdx - 1),
		);

		// Hero Touch Swipe
		heroSection?.addEventListener("touchstart", (e: any) => {
			touchStartX = e.changedTouches[0].screenX;
		}, { passive: true });

		heroSection?.addEventListener("touchend", (e: any) => {
			touchEndX = e.changedTouches[0].screenX;
			handleHeroSwipe();
		}, { passive: true });

		function handleHeroSwipe() {
			const swipeThreshold = 50;
			if (touchStartX - touchEndX > swipeThreshold) {
				updateHero(heroIdx + 1); // Swipe Left -> Next
			} else if (touchEndX - touchStartX > swipeThreshold) {
				updateHero(heroIdx - 1); // Swipe Right -> Prev
			}
		}

		// 3. Collection Infinite Loop Slider + Auto-Flow
		const track = document.querySelector(".collection-track") as HTMLElement;
		const progress = document.querySelector(".progress-fill") as HTMLElement;
		const collectionButtons = document.querySelectorAll(".slider-controls-v5 .arrow-circ");
		const prevCol = collectionButtons[0];
		const nextCol = collectionButtons[1];

		if (track && progress) {
			const totalWidth = track.scrollWidth;
			track.scrollLeft = totalWidth / 3;

			let isAutoPlaying = true;
			let animationFrame: number;
			let interactionTimeout: any;

			const autoScroll = () => {
				if (isAutoPlaying) {
					track.scrollLeft += 0.8; // Silky slow speed
				}
				animationFrame = requestAnimationFrame(autoScroll);
			};

			track.addEventListener("scroll", () => {
				const currentScroll = track.scrollLeft;

				// Seamless Jump Logic
				if (currentScroll <= 10) {
					track.scrollLeft = totalWidth / 3;
				} else if (currentScroll >= (totalWidth * 2 / 3)) {
					track.scrollLeft = totalWidth / 3;
				}

				// Progress bar (mapped to one "loop" segment)
				const segmentWidth = totalWidth / 3;
				const segmentScroll = currentScroll % segmentWidth;
				const scrollPercent = (segmentScroll / (segmentWidth - track.clientWidth)) * 100;
				progress.style.width = `${Math.min(100, Math.max(0, scrollPercent))}%`;
			});

			// Interaction Control
			track.addEventListener("mouseenter", () => isAutoPlaying = false);
			track.addEventListener("mouseleave", () => isAutoPlaying = true);
			
			track.addEventListener("touchstart", () => {
				isAutoPlaying = false;
				clearTimeout(interactionTimeout);
			}, { passive: true });

			track.addEventListener("touchend", () => {
				interactionTimeout = setTimeout(() => {
					isAutoPlaying = true;
				}, 3000);
			}, { passive: true });

			nextCol?.addEventListener("click", () => {
				isAutoPlaying = false;
				track.scrollBy({ left: 400, behavior: "smooth" });
				clearTimeout(interactionTimeout);
				interactionTimeout = setTimeout(() => isAutoPlaying = true, 3000);
			});
			prevCol?.addEventListener("click", () => {
				isAutoPlaying = false;
				track.scrollBy({ left: -400, behavior: "smooth" });
				clearTimeout(interactionTimeout);
				interactionTimeout = setTimeout(() => isAutoPlaying = true, 3000);
			});

			autoScroll();
		}

		// 4. Machinery Gallery Slider
		const machineDots = document.querySelectorAll(".v-dots span");
		const machineryVisual = document.querySelector(".machinery-visual");
		const machineImg = document.getElementById("machineImg") as HTMLImageElement;
		const machineImages = [
			"/images/machinery.jpg",
			"/images/machinery-2.jpg",
			"/images/machinery-3.jpg"
		];
		let machineIdx = 0;
		let machineStartX = 0;
		let machineEndX = 0;

		function updateMachine(newIdx: number) {
			machineDots.forEach((d) => d.classList.remove("active"));
			machineIdx = (newIdx + machineDots.length) % machineDots.length;
			machineDots[machineIdx].classList.add("active");
			
			if (machineImg) {
				machineImg.style.opacity = "0";
				setTimeout(() => {
					machineImg.src = machineImages[machineIdx];
					machineImg.style.opacity = "1";
				}, 300);
			}
		}

		machineDots.forEach((dot, i) => {
			dot.addEventListener("click", () => updateMachine(i));
		});

		machineryVisual?.addEventListener("touchstart", (e: any) => {
			machineStartX = e.changedTouches[0].screenX;
		}, { passive: true });

		machineryVisual?.addEventListener("touchend", (e: any) => {
			machineEndX = e.changedTouches[0].screenX;
			const threshold = 50;
			if (machineStartX - machineEndX > threshold) {
				updateMachine(machineIdx + 1);
			} else if (machineEndX - machineStartX > threshold) {
				updateMachine(machineIdx - 1);
			}
		}, { passive: true });
	</script>

	<!-- SS3: New Collection -->
	<section class="section-padding bg-white">
		<div class="container">
			<h2 class="text-maroon section-title">New Collection</h2>
			<div class="collection-wrapper">
				<div class="collection-track">
					{
						[...sarees, ...sarees, ...sarees].map((saree, i) => (
							<div
								class={`collection-card card-${(i % 5) + 1}`}
							>
								<img src={saree.src} alt={saree.alt} />
							</div>
						))
					}
				</div>
				<div class="slider-controls-v5">
					<button class="arrow-circ">←</button>
					<div class="progress-bar-v5">
						<div class="progress-fill"></div>
					</div>
					<button class="arrow-circ">→</button>
				</div>
			</div>
		</div>
	</section>

	<!-- SS4: Excellence Section -->
	<section class="section-padding bg-maroon">
		<div class="container excellence-grid">
			<div class="excellence-image">
				<img
					src="/images/woman-green-sari-sits-couch.jpg"
					alt="Quality Excellence"
					class="rounded-img"
				/>
				<div class="exp-badge">
					<span class="count">15+</span>
					<span class="label"
						>Years Experience in<br />Textile Industry</span
					>
				</div>
			</div>
			<div class="excellence-content">
				<h2 class="text-white">
					A Decade of Excellence<br />and Innovation
				</h2>
				<div class="divider-line divider-gold small-divider">
				</div>
				<h3 class="text-gold">
					Celebrating Progress and Responsibility
				</h3>
				<p class="text-white body-p">
					Established in 2007 in Jetpur, Gujarat, Usha Cotton has risen as a beacon in the textile industry. We are renowned for our exquisite sarees that perfectly blend India's rich textile traditions with pioneering technologies, achieving a 95% customer satisfaction rate.
				</p>
			</div>
		</div>
	</section>

	<!-- SS5: Modern Technology -->
	<section class="section-padding">
		<div class="container machinery-grid">
			<div class="machinery-content">
				<h2 class="text-maroon">
					Modern Machinery,<br />Traditional Trust
				</h2>
				<div class="divider-line divider-navy small-divider">
				</div>
				<p class="body-p">
					Our state-of-the-art manufacturing facilities are equipped with the latest technology, including automated fabric cutting systems and ERP integration. By seamlessly integrating sophisticated digital printing techniques with established reactive methods, we optimize efficiency for high-volume production while maintaining impeccable quality.
				</p>
			</div>
			<div class="machinery-visual">
				<img
					src="/images/machinery.jpg"
					alt="Advanced Machinery"
					class="rounded-img"
					id="machineImg"
					style="transition: opacity 0.3s ease;"
				/>
				<div class="v-dots">
					<span class="active"></span>
					<span></span>
					<span></span>
				</div>
			</div>
		</div>
	</section>

	<!-- SS6: Journey Section -->
	<section class="section-padding bg-cream">
		<div class="container journey-grid">
			<div class="journey-visual">
				<img
					src="/images/businessman-standing-top-concrete-stairway-watching-town-future-success-leadership-concept.jpg"
					alt="Founder Journey"
					class="rounded-img"
				/>
			</div>
			<div class="journey-text-content">
				<h2 class="text-maroon journey-heading">
					The Journey<br />of Founder
				</h2>
				<div class="timeline-visual">
					<div class="swoosh-container">
						<img
							src="/images/swooshBig.png"
							alt="Journey Route"
							class="swoosh-img"
						/>
					</div>
				</div>
				<a href="#" class="btn btn-white journey-btn"
					>View Journey</a
				>
			</div>
		</div>
	</section>

	<!-- SS7: Callout Section -->
	<section class="section-padding bg-cream">
		<div class="container">
			<div class="callout-heading">
				<h2 class="text-navy">
					We give <span class="highlight-maroon">top production</span> from every angle
				</h2>
				<div class="callout-divider"></div>
			</div>
			<div class="services-grid">
				<div class="service-card">
					<div class="card-icon">
						<img
							src="/images/icons/icon-fabrics.png"
							alt="Fabrics"
							class="icon-img"
						/>
					</div>
					<div class="card-line"></div>
					<h3 class="card-title">
						Premium Fabrics<br/>and Materials
					</h3>
					<p class="card-body">
						Select from a diverse range of premium dress materials tailored for modern comfort.
					</p>
				</div>
				<div class="service-card">
					<div class="card-icon">
						<img
							src="/images/icons/icon-design.png"
							alt="Design"
							class="icon-img"
						/>
					</div>
					<div class="card-line"></div>
					<h3 class="card-title">
						Bespoke Design<br/>and Customization
					</h3>
					<p class="card-body">
						Leverage our advanced digital capabilities for bespoke pattern and colour customization.
					</p>
				</div>
				<div class="service-card">
					<div class="card-icon">
						<img
							src="/images/icons/icon-quantity.png"
							alt="Quantity"
							class="icon-img"
						/>
					</div>
					<div class="card-line"></div>
					<h3 class="card-title">
						High-Volume<br/>Scalable Production
					</h3>
					<p class="card-body">
						Our lean manufacturing principles optimize efficiency for rapid, high-volume production.
					</p>
				</div>
			</div>
		</div>
	</section>

	<style>
		/* SS2: HERO */
		.hero-section {
			height: 100vh;
			position: relative;
			overflow: hidden;
		}
		.hero-slides {
			position: absolute;
			inset: 0;
		}
		.hero-slide {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			opacity: 0;
			transition: opacity 1.5s ease;
			display: flex;
			align-items: center;
		}
		.hero-slide.active {
			opacity: 1;
			z-index: 1;
		}
		.hero-bg {
			position: absolute;
			inset: 0;
			z-index: -1;
		}
		.hero-bg img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.hero-inner {
			position: relative;
			z-index: 2;
			transform: translateY(30px);
			transition: transform 1s ease;
		}
		.hero-slide.active .hero-inner {
			transform: translateY(0);
		}
		.hero-section h1 {
			font-size: 64px;
		}
		.hero-divider {
			width: 140px;
			height: 4px;
			margin: 25px 0;
		}
		.hero-controls {
			position: absolute;
			top: 50%;
			width: 100%;
			display: flex;
			justify-content: space-between;
			padding: 0 40px;
			transform: translateY(-50%);
			pointer-events: none;
			z-index: 10;
		}
		.nav-btn {
			pointer-events: auto;
			background: none;
			border: none;
			color: white;
			width: 50px;
			height: 50px;
			cursor: pointer;
			opacity: 0.7;
			transition: opacity 0.3s;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.nav-btn svg {
			width: 40px;
			height: 40px;
		}
		.nav-btn:hover {
			opacity: 1;
		}

		/* SS3: COLLECTION */
		.section-title {
			text-align: center;
			margin-bottom: 60px;
			font-size: 64px;
			font-weight: 400;
		}
		.collection-wrapper {
			width: 100%;
			margin: 0 auto;
			position: relative;
			padding-bottom: 80px;
		}
		.collection-track {
			display: flex;
			gap: 30px;
			align-items: flex-start;
			overflow-x: auto;
			scroll-behavior: smooth;
			-ms-overflow-style: none;
			scrollbar-width: none;
			padding: 0 50px;
		}
		.collection-track::-webkit-scrollbar {
			display: none;
		}
		.collection-card {
			width: 285px;
			flex-shrink: 0;
		}
		.collection-card img {
			width: 100%;
			height: 420px;
			object-fit: cover;
			border-radius: 40px;
			box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
		}
		/* Organic Wave Rhythm */
		.card-1 {
			margin-top: 20px;
		}
		.card-2 {
			margin-top: 150px;
		}
		.card-3 {
			margin-top: 60px;
		}
		.card-4 {
			margin-top: 120px;
		}
		.card-5 {
			margin-top: 40px;
		}
		.slider-controls-v5 {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 30px;
			position: absolute;
			bottom: 0;
			left: 50%;
			transform: translateX(-50%);
			width: 100%;
		}
		.progress-bar-v5 {
			width: 100%;
			max-width: 764px;
			height: 4px;
			background: #e0e0e0;
			border-radius: 10px;
			position: relative;
		}
		.progress-fill {
			position: absolute;
			left: 0;
			top: 0;
			height: 100%;
			width: 5%;
			background: var(--color-navy);
			border-radius: 10px;
			transition: width 0.2s ease;
		}
		.arrow-circ {
			width: 45px;
			height: 45px;
			border: 1px solid #ddd;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			background: none;
			cursor: pointer;
			color: var(--color-navy);
		}

		/* SS4: EXCELLENCE */
		.excellence-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 80px;
			align-items: center;
		}
		.excellence-image {
			position: relative;
		}
		.rounded-img {
			border-radius: 40px;
			width: 100%;
		}
		.exp-badge {
			position: absolute;
			bottom: -30px;
			left: -30px;
			background: white;
			padding: 25px 40px;
			border-radius: 20px;
			display: flex;
			gap: 20px;
			align-items: center;
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
			z-index: 5;
		}
		.exp-badge .count {
			font-size: 40px;
			font-weight: bold;
			font-family: var(--font-heading);
			color: var(--color-maroon);
		}
		.exp-badge .label {
			font-size: 12px;
			font-weight: bold;
			text-transform: uppercase;
			line-height: 1.4;
			color: var(--color-maroon);
		}
		.excellence-content h2 {
			font-size: 48px;
		}
		.small-divider {
			width: 80px;
			margin: 20px 0;
		}
		.excellence-content h3 {
			font-family: var(--font-body);
			font-size: 16px;
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: 4px;
			margin-bottom: 25px;
		}
		.body-p {
			font-size: 16px;
			line-height: 1.8;
			opacity: 0.9;
		}

		/* SS5: MACHINERY */
		.machinery-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 80px;
			align-items: center;
		}
		.machinery-content h2 {
			font-size: 48px;
		}
		.machinery-visual {
			position: relative;
			padding-bottom: 40px;
		}
		.v-dots {
			display: flex;
			gap: 10px;
			margin-top: 20px;
			justify-content: center;
			width: 100%;
		}
		.v-dots span {
			width: 8px;
			height: 8px;
			background: #ddd;
			border-radius: 50%;
		}
		.v-dots span.active {
			background: var(--color-navy);
		}

		/* SS6: JOURNEY */
		.journey-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 60px;
			align-items: center;
			padding: 100px 0;
		}
		.journey-text-content {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
		.journey-heading {
			font-size: 64px;
			line-height: 1.1;
			margin-bottom: 20px;
		}
		.timeline-visual {
			width: 100%;
			position: relative;
			margin: 40px 0;
		}
		.swoosh-container {
			width: 100%;
			max-width: 1000px;
			margin: 0 auto;
			overflow: hidden;
		}
		.swoosh-img {
			width: 100%;
			height: auto;
			display: block;
			filter: saturate(1.2);
		}
		.journey-btn {
			padding: 18px 50px;
			border-radius: 50px;
			font-weight: 600;
			font-size: 16px;
			border: 1px solid #eee;
			background: white;
			color: var(--color-navy);
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
		}

		/* SS7: CALLOUT */
		.callout-heading {
			text-align: center;
			margin-bottom: 60px;
		}
		.callout-heading h2 {
			font-size: 48px;
			font-weight: 500;
			letter-spacing: -0.01em;
		}
		.highlight-maroon {
			color: var(--color-maroon);
		}
		.callout-divider {
			width: 80px;
			height: 5px;
			background: var(--color-maroon);
			margin: 15px auto 0;
			border-radius: 10px;
		}
		.services-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 30px;
		}
		.service-card {
			background: #f8f9fb;
			padding: 50px 40px;
			border-radius: 30px;
			text-align: left;
			transition: transform 0.3s;
		}
		.service-card:hover { transform: translateY(-5px); }
		.card-icon {
			margin-bottom: 25px;
		}
		.icon-img {
			height: 50px;
			width: auto;
		}
		.card-line {
			width: 100%;
			height: 1.5px;
			background: var(--color-navy);
			margin-bottom: 30px;
			opacity: 0.8;
		}
		.card-title {
			font-size: 28px;
			font-weight: 500;
			margin-bottom: 25px;
			color: var(--color-navy);
			line-height: 1.3;
		}
		.card-body {
			font-family: var(--font-body);
			font-size: 15px;
			color: #888;
			line-height: 1.6;
			margin: 0;
