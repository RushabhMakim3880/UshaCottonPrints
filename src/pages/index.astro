				left: 0;
				width: 100%;
				height: 100%;
				background: var(--color-white);
				z-index: 2000;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 30px;
				transform: translateY(-100%);
				transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
			}
			.mobile-nav-overlay.active {
				transform: translateY(0);
			}
			.mobile-nav-overlay a {
				font-size: 24px;
				color: var(--color-navy);
				font-weight: 500;
				text-decoration: none;
			}
			.mobile-nav-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 30px;
				background: none;
				border: none;
				color: var(--color-navy);
			}

			/* SS2: HERO */
			.hero-section {
				height: 100vh;
				position: relative;
				overflow: hidden;
				width: 100vw;
			}
			.hero-slider {
				height: 100%;
				width: 100%;
				position: relative;
			}
			.hero-slide {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				transition: opacity 1.5s ease;
				display: flex;
				align-items: center;
			}
			.hero-slide.active {
				opacity: 1;
				z-index: 1;
			}
			.hero-slide img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
			}
			.hero-inner {
				position: relative;
				z-index: 2;
				transform: translateY(30px);
				transition: transform 1s ease;
			}
			.hero-slide.active .hero-inner {
				transform: translateY(0);
			}
			.hero-section h1 {
				font-size: 64px;
			}
			.hero-divider {
				width: 140px;
				height: 4px;
				margin: 25px 0;
			}
			.sub-heading {
				font-size: 24px;
				font-weight: bold;
			}
			.hero-controls {
				position: absolute;
				top: 50%;
				width: 100%;
				display: flex;
				justify-content: space-between;
				padding: 0 40px;
				transform: translateY(-50%);
				pointer-events: none;
				z-index: 10;
			}
			.nav-btn {
				pointer-events: auto;
				background: none;
				border: none;
				color: white;
				width: 50px;
				height: 50px;
				cursor: pointer;
				opacity: 0.7;
				transition: opacity 0.3s;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.nav-btn svg {
				width: 40px;
				height: 40px;
			}
			.nav-btn:hover {
				opacity: 1;
			}

			/* SS3: COLLECTION */
			.section-title {
				text-align: center;
				margin-bottom: 60px;
				font-size: 64px;
				font-weight: 400;
			}
			.collection-wrapper {
				width: 100%;
				margin: 0 auto;
				position: relative;
				padding-bottom: 80px;
			}
			.collection-track {
				display: flex;
				gap: 30px;
				align-items: flex-start;
				overflow-x: auto;
				scroll-behavior: smooth;
				-ms-overflow-style: none;
				scrollbar-width: none;
				padding: 0 50px;
			}
			.collection-track::-webkit-scrollbar {
				display: none;
			}
			.collection-card {
				width: 285px;
				flex-shrink: 0;
			}
			.collection-card img {
				width: 100%;
				height: 420px;
				object-fit: cover;
				border-radius: 40px;
				box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
			}
			/* Organic Wave Rhythm */
			.card-1 {
				margin-top: 20px;
			}
			.card-2 {
				margin-top: 150px;
			}
			.card-3 {
				margin-top: 60px;
			}
			.card-4 {
				margin-top: 120px;
			}
			.card-5 {
				margin-top: 40px;
			}
			.slider-controls-v5 {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 30px;
				position: absolute;
				bottom: 0;
				left: 50%;
				transform: translateX(-50%);
				width: 100%;
			}
			.progress-bar-v5 {
				width: 764px;
				height: 4px;
				background: #e0e0e0;
				border-radius: 10px;
				position: relative;
			}
			.progress-fill {
				position: absolute;
				left: 0;
				top: 0;
				height: 100%;
				width: 5%;
				background: var(--color-navy);
				border-radius: 10px;
				transition: width 0.2s ease;
			}
			.arrow-circ {
				width: 45px;
				height: 45px;
				border: 1px solid #ddd;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: none;
				cursor: pointer;
				color: var(--color-navy);
			}

			/* SS4: EXCELLENCE */
			.excellence-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 80px;
				align-items: center;
			}
			.excellence-image {
				position: relative;
			}
			.rounded-img {
				border-radius: 40px;
				width: 100%;
			}
			.exp-badge {
				position: absolute;
				bottom: -30px;
				left: -30px;
				background: white;
				padding: 25px 40px;
				border-radius: 20px;
				display: flex;
				gap: 20px;
				align-items: center;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
				z-index: 5;
			}
			.exp-badge .count {
				font-size: 40px;
				font-weight: bold;
				font-family: var(--font-heading);
				color: var(--color-maroon);
			}
			.exp-badge .label {
				font-size: 12px;
				font-weight: bold;
				text-transform: uppercase;
				line-height: 1.4;
				color: var(--color-maroon);
			}
			.excellence-content h2 {
				font-size: 48px;
			}
			.small-divider {
				width: 80px;
				margin: 20px 0;
			}
			.excellence-content h3 {
				font-family: var(--font-body);
				font-size: 24px;
				font-weight: bold;
				margin-bottom: 25px;
			}
			.body-p {
				font-size: 16px;
				line-height: 1.8;
				opacity: 0.9;
			}

			/* SS5: MACHINERY */
			.machinery-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 80px;
				align-items: center;
			}
			.machinery-content h2 {
				font-size: 48px;
			}
			.machinery-visual {
				position: relative;
				padding-bottom: 40px;
			}
			.v-dots {
				display: flex;
				gap: 10px;
				margin-top: 20px;
				justify-content: center;
				width: 100%;
			}
			.v-dots span {
				width: 8px;
				height: 8px;
				background: #ddd;
				border-radius: 50%;
			}
			.v-dots span.active {
				background: var(--color-navy);
			}

			/* SS6: JOURNEY */
			.journey-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 60px;
				align-items: center;
				padding: 100px 0;
			}
			.journey-text-content {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
			}
			.journey-heading {
				font-size: 64px;
				line-height: 1.1;
				margin-bottom: 20px;
			}
			.timeline-visual {
				width: 100%;
				position: relative;
				margin: 40px 0;
			}
			.swoosh-container {
				width: 210%;
				max-width: 1000px;
				margin: 0 auto;
			}
			.swoosh-img {
				width: 300%;
				height: auto;
				display: block;
				filter: saturate(1.2);
			}
			.journey-btn {
				padding: 18px 50px;
				border-radius: 50px;
				font-weight: 600;
				font-size: 16px;
				border: 1px solid #eee;
				background: white;
				color: var(--color-navy);
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
			}

			/* SS7: CALLOUT */
			.callout-heading {
				text-align: center;
				margin-bottom: 60px;
			}
			.callout-heading h2 {
				font-family: var(--font-body);
				font-size: 48px;
				font-weight: 500;
				letter-spacing: -0.01em;
			}
			.highlight-maroon {
				position: relative;
				display: inline-block;
			}
			.highlight-maroon::after {
				content: "";
				position: absolute;
				bottom: -12px;
				left: 50%;
				transform: translateX(-50%);
				width: 70px;
				height: 5px;
				background: var(--color-maroon);
				border-radius: 2px;
			}
			.services-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 30px;
			}
			.service-card {
				background: #f8f9fb;
				padding: 50px 40px;
				border-radius: 30px;
				text-align: left;
				transition: transform 0.3s;
			}
			.service-card:hover { transform: translateY(-5px); }
			.card-icon {
				margin-bottom: 25px;
			}
			.icon-img {
				height: 50px;
				width: auto;
			}
			.card-line {
				width: 100%;
				height: 1.5px;
				background: var(--color-navy);
				margin-bottom: 30px;
				opacity: 0.8;
			}
			.card-title {
				font-family: var(--font-body);
				font-size: 24px;
				font-weight: 500;
				margin-bottom: 25px;
				color: var(--color-navy);
				line-height: 1.3;
			}
			.card-body {
				font-family: var(--font-body);
				font-size: 15px;
				color: #888;
				line-height: 1.6;
				margin: 0;
			}

			/* SS8: FOOTER */
			.footer-section {
				padding: 80px 0;
			}
			.footer-flex {
				display: grid;
				grid-template-columns: 1.5fr 2fr 1.5fr 2fr;
				gap: 40px;
				align-items: start;
			}
			.logo-footer {
				width: 180px;
			}
			.f-nav {
				display: flex;
				gap: 60px;
			}
			.f-nav-col {
				display: flex;
				flex-direction: column;
				gap: 15px;
			}
			.f-nav a {
				font-weight: 500;
				font-size: 1rem;
				color: white;
			}
			.f-socials {
				display: flex;
				gap: 12px;
			}
			.icon-circ {
				width: 36px;
				height: 36px;
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 14px;
				transition: all 0.3s;
			}
			.icon-circ:hover {
				background: white;
			}
			.icon-circ:hover svg {
				fill: var(--color-maroon);
			}
			.f-address p {
				font-size: 14px;
				line-height: 1.8;
				opacity: 0.9;
				text-align: left;
			}

			@media (max-width: 1024px) {
				.container {
					width: 100% !important;
					max-width: 100% !important;
					padding: 0 20px !important;
					margin: 0 auto !important;
				}
				.section-padding {
					padding: 60px 0 !important;
				}
				.nav-links {
					display: none !important;
				}
				.mobile-menu-toggle {
					display: flex !important;
				}
				.hero-section h1 {
					font-size: 38px !important;
					text-align: center !important;
					line-height: 1.2 !important;
				}
				.hero-text {
					text-align: center !important;
					max-width: 100% !important;
					padding: 0 10px !important;
					margin: 0 auto !important;
				}
				.hero-text .btn-v2 {
					margin: 20px auto 0 !important;
				}
				.section-title {
					font-size: 36px !important;
					text-align: center !important;
					width: 100% !important;
					margin-bottom: 40px !important;
				}
				.excellence-grid, .machinery-grid, .journey-grid, .footer-flex {
					grid-template-columns: 1fr !important;
					gap: 40px !important;
					text-align: center !important;
				}
				.excellence-content, .machinery-content, .journey-text-content {
					text-align: center !important;
					max-width: 100% !important;
					margin: 0 auto !important;
				}
				.journey-heading {
					font-size: 42px !important;
				}
				.journey-text-content .btn-v2, .journey-btn {
					margin: 30px auto 0 !important;
				}
				.services-grid {
					grid-template-columns: 1fr !important;
					gap: 20px !important;
					width: 100% !important;
				}
				.service-card, .machinery-card {
					min-width: unset !important;
					width: 100% !important;
					max-width: 100% !important;
					text-align: center !important;
					padding: 40px 20px !important;
				}
				.card-icon, .card-line {
					margin-left: auto !important;
					margin-right: auto !important;
				}
				.footer-grid {
					grid-template-columns: 1fr !important;
					text-align: center !important;
				}
				.logo-footer {
					margin: 0 auto !important;
				}
				.f-address p {
					text-align: center !important;
					justify-content: center !important;
				}
				.f-nav {
					flex-direction: column !important;
					gap: 20px !important;
					align-items: center !important;
				}
				.f-socials {
					justify-content: center !important;
				}
				.collection-track {
					padding: 0 20px !important;
				}
				.collection-card {
					min-width: 260px !important;
				}
				.hero-controls {
					display: none !important;
				}
			}

			@media (max-width: 768px) {
				.hero-section h1 {
					font-size: 32px !important;
				}
				.section-title {
					font-size: 32px !important;
				}
				.journey-heading {
					font-size: 36px !important;
				}
			}
		</style>
	</body>
</html>
