<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>USHA COTTON PRINTS | Traditional Trust Since 1994</title>
	</head>
	<body>
		<!-- SS1: Header -->
		<header class="header transparent">
			<div class="container header-flex">
				<div class="logo-area">
					<img
						src="/images/logo.png"
						alt="Usha Logo"
						class="brand-logo"
					/>
				</div>
				<nav class="nav-links">
					<a href="#about">About us</a>
					<a href="#printing">Printing</a>
					<a href="#products">Products</a>
					<a href="#contact">Contact</a>
				</nav>
				<div class="header-actions">
					<button class="mobile-menu-toggle" id="menuToggle">
						<span></span>
						<span></span>
					</button>
				</div>
			</div>
		</header>

		<!-- Mobile Nav Overlay -->
		<div class="mobile-nav-overlay" id="mobileNav">
			<button class="mobile-nav-close" id="closeMenu">✕</button>
			<a href="#about">About us</a>
			<a href="#printing">Printing</a>
			<a href="#products">Products</a>
			<a href="#contact">Contact</a>
		</div>

		<main>
			<!-- SS2: Hero -->
			<section class="hero-section">
				<div class="hero-slides">
					{
						heroSlides.map((slide, i) => (
							<div
								class={`hero-slide ${i === 0 ? "active" : ""}`}
								data-index={i}
							>
								<div class="hero-bg">
									<img src={slide.img} alt={slide.sub} />
								</div>
								<div class="container hero-inner">
									<h1
										class="text-maroon"
										set:html={slide.title}
									/>
									<div class="hero-divider divider-white" />
									<p class="text-navy sub-heading">
										{slide.sub}
									</p>
								</div>
							</div>
						))
					}
				</div>
				<div class="hero-controls">
					<button class="nav-btn prev">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							><path d="M15 19l-7-7 7-7"></path></svg
						>
					</button>
					<button class="nav-btn next">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							><path d="M9 5l7 7-7 7"></path></svg
						>
					</button>
				</div>
			</section>

			<script>
				// 1. Header Scroll Logic
				const header = document.querySelector(".header");
				if (header) {
					window.addEventListener("scroll", () => {
						if (window.scrollY > 50) {
							header.classList.remove("transparent");
							header.classList.add("scrolled");
						} else {
							header.classList.add("transparent");
							header.classList.remove("scrolled");
						}
					});
				}

				// 2. Hero Slider Logic
				const slides = document.querySelectorAll(".hero-slide");
				const nextHero = document.querySelector(".hero-controls .next");
				const prevHero = document.querySelector(".hero-controls .prev");
				let heroIdx = 0;

				function updateHero(newIdx: number) {
					slides[heroIdx].classList.remove("active");
					heroIdx = (newIdx + slides.length) % slides.length;
					slides[heroIdx].classList.add("active");
				}

				nextHero?.addEventListener("click", () =>
					updateHero(heroIdx + 1),
				);
				prevHero?.addEventListener("click", () =>
					updateHero(heroIdx - 1),
				);

				// 3. Collection Infinite Loop Slider + Auto-Flow
				const track = document.querySelector(".collection-track") as HTMLElement;
				const progress = document.querySelector(".progress-fill") as HTMLElement;
				const collectionButtons = document.querySelectorAll(".slider-controls-v5 .arrow-circ");
				const prevCol = collectionButtons[0];
				const nextCol = collectionButtons[1];

				if (track && progress) {
					const totalWidth = track.scrollWidth;
					track.scrollLeft = totalWidth / 3;

					let isAutoPlaying = true;
					let animationFrame: number;

					const autoScroll = () => {
						if (isAutoPlaying) {
							track.scrollLeft += 0.8; // Silky slow speed
						}
						animationFrame = requestAnimationFrame(autoScroll);
					};

					track.addEventListener("scroll", () => {
						const currentScroll = track.scrollLeft;

						// Seamless Jump Logic
						if (currentScroll <= 10) {
							track.scrollLeft = totalWidth / 3;
						} else if (currentScroll >= (totalWidth * 2 / 3)) {
							track.scrollLeft = totalWidth / 3;
						}

						// Progress bar (mapped to one "loop" segment)
						const segmentWidth = totalWidth / 3;
						const segmentScroll = currentScroll % segmentWidth;
						const scrollPercent = (segmentScroll / (segmentWidth - track.clientWidth)) * 100;
						progress.style.width = `${Math.min(100, Math.max(0, scrollPercent))}%`;
					});

					// Interaction Control
					track.addEventListener("mouseenter", () => isAutoPlaying = false);
					track.addEventListener("mouseleave", () => isAutoPlaying = true);
					track.addEventListener("touchstart", () => isAutoPlaying = false);
					track.addEventListener("touchend", () => isAutoPlaying = true);

					nextCol?.addEventListener("click", () => {
						isAutoPlaying = false;
						track.scrollBy({ left: 400, behavior: "smooth" });
						setTimeout(() => isAutoPlaying = true, 3000);
					});
					prevCol?.addEventListener("click", () => {
						isAutoPlaying = false;
						track.scrollBy({ left: -400, behavior: "smooth" });
						setTimeout(() => isAutoPlaying = true, 3000);
					});

					autoScroll();
				}

				// 4. Machinery Gallery Dots
				const machineDots = document.querySelectorAll(".v-dots span");
				machineDots.forEach((dot, i) => {
					dot.addEventListener("click", () => {
						machineDots.forEach((d) =>
							d.classList.remove("active"),
						);
						dot.classList.add("active");
						// Simple feedback for demo
						const img = document.querySelector(
							".machinery-visual img",
						) as HTMLElement;
						if (img) img.style.opacity = "0.5";
						setTimeout(() => {
							if (img) img.style.opacity = "1";
						}, 200);
					});
				});

				// 5. Mobile Menu Toggle
				const menuToggle = document.getElementById("menuToggle");
				const closeMenu = document.getElementById("closeMenu");
				const mobileNav = document.getElementById("mobileNav");
				const mobileLinks = document.querySelectorAll(".mobile-nav-overlay a");

				menuToggle?.addEventListener("click", () => {
					mobileNav?.classList.add("active");
				});

				closeMenu?.addEventListener("click", () => {
					mobileNav?.classList.remove("active");
				});

				mobileLinks.forEach(link => {
					link.addEventListener("click", () => {
						mobileNav?.classList.remove("active");
					});
				});
			</script>

			<!-- SS3: New Collection (Pixel Perfect Staggered Slider) -->
