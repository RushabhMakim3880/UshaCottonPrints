---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us | USHA COTTON LIMITED">
	<!-- Page Hero -->
	<section class="page-hero bg-maroon">
		<div class="container">
			<h1 class="text-white text-center">Our Heritage and Vision</h1>
			<div class="divider-line divider-gold mx-auto"></div>
			<p class="text-white text-center sub-heading">Crafting Joy and Confidence Since 2007</p>
		</div>
	</section>

	<!-- Introduction -->
	<section class="section-padding bg-cream">
		<div class="container excellence-grid">
			<div class="excellence-content">
				<h2 class="text-navy">Standing at the Crossroads<br/><span class="highlight-maroon">of Tradition and Modernity</span></h2>
				<div class="divider-line divider-maroon small-divider"></div>
				<p class="body-p">
					Established in 2007 in Jetpur, Gujarat, Usha Cotton has risen as a beacon in the textile industry. We are renowned for our exquisite sarees that perfectly blend India's rich textile traditions with pioneering technologies.
				</p>
				<p class="body-p" style="margin-top: 15px;">
					Committed to bringing the art of Indian textiles into the global fashion arena, we have achieved a 95% customer satisfaction rate through our dedication to quality and innovation.
				</p>
			</div>
			<div class="excellence-image">
				<img
					src="/images/young-indian-woman-wearing-sari-posing-historic-building-india.jpg"
					alt="Usha Heritage"
					class="rounded-img"
				/>
				<div class="exp-badge">
					<span class="count">2007</span>
					<span class="label">Established<br/>in Jetpur</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Philosophy -->
	<section class="section-padding bg-white">
		<div class="container">
			<div class="callout-heading">
				<h2 class="text-navy">Our Philosophy</h2>
				<div class="callout-divider"></div>
			</div>
			<div class="services-grid">
				<div class="service-card">
					<h3 class="card-title">Purpose</h3>
					<div class="card-line"></div>
					<p class="card-body">
						<strong>"Crafting Joy and Confidence"</strong><br/>
						We create modern and traditional clothing that brings joy and pride to those who wear it. We aim to uplift artisans, honour their skills, and empower our customers to feel confident and stylish daily.
					</p>
				</div>
				<div class="service-card">
					<h3 class="card-title">Vision</h3>
					<div class="card-line"></div>
					<p class="card-body">
						<strong>"Leading with Legacy and Innovation"</strong><br/>
						We aspire to be a global leader in textiles, blending tradition with innovation to set new standards in sarees, kurtis, and dress materials for customers worldwide.
					</p>
				</div>
				<div class="service-card">
					<h3 class="card-title">Mission</h3>
					<div class="card-line"></div>
					<p class="card-body">
						<strong>"Weaving Style and Comfort"</strong><br/>
						We craft ethnic wear that exemplifies style, comfort, and affordability, consistently meeting the fashion aspirations of women globally.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Values -->
	<section class="section-padding bg-maroon">
		<div class="container text-center">
			<h2 class="text-white" style="margin-bottom: 50px;">Our Core Values</h2>
			<div class="values-grid">
				<div class="value-box">
					<h3 class="text-gold">Excellence</h3>
					<p class="text-white">Achieving the highest levels of quality and continuously improving.</p>
				</div>
				<div class="value-box">
					<h3 class="text-gold">Innovation</h3>
					<p class="text-white">Creating unique and appealing products to stay ahead in a dynamic market.</p>
				</div>
				<div class="value-box">
					<h3 class="text-gold">Tradition</h3>
					<p class="text-white">Upholding the rich traditions of textile craftsmanship.</p>
				</div>
				<div class="value-box">
					<h3 class="text-gold">Honesty</h3>
					<p class="text-white">Operating with transparency and integrity.</p>
				</div>
				<div class="value-box">
					<h3 class="text-gold">Trust</h3>
					<p class="text-white">Being a reliable partner and consistently delivering on our promises.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Chairman's Message -->
	<section class="section-padding bg-cream">
		<div class="container quote-container">
			<div class="quote-mark">"</div>
			<h3 class="text-navy quote-text">
				As the Chairman of Usha Cotton, I am privileged to steer an organisation that beautifully marries heritage with innovation. Established to honour India's rich textile traditions, we continually embrace cutting-edge technologies, crafting products that surpass global expectations. Every saree we create reflects our team's skill, dedication, and passion. Looking ahead, we see boundless opportunities and remain steadfast in our drive towards innovation, integrity, and sustainability.
			</h3>
			<div class="divider-line divider-maroon mx-auto" style="width: 60px; margin-top: 30px; margin-bottom: 10px;"></div>
			<p class="text-maroon" style="font-family: var(--font-body); font-weight: bold;">Chairman, Usha Cotton</p>
		</div>
	</section>

	<!-- Infrastructure & CSR -->
	<section class="section-padding bg-white">
		<div class="container machinery-grid">
			<div class="machinery-visual">
				<img
					src="/images/machinery.jpg"
					alt="Infrastructure"
					class="rounded-img"
				/>
			</div>
			<div class="machinery-content">
				<h2 class="text-maroon">Infrastructure and<br/>Sustainability</h2>
				<div class="divider-line divider-navy small-divider"></div>
				<p class="body-p" style="margin-bottom: 20px;">
					<strong>Infrastructure & Operations:</strong> Our state-of-the-art manufacturing facilities in Jetpur are equipped with the latest technology, including automated fabric cutting systems and ERP integration. By implementing lean manufacturing principles, we optimize efficiency for high-volume production while maintaining impeccable quality.
				</p>
				<p class="body-p">
					<strong>Sustainability & CSR:</strong> Our commitment extends beyond textiles. We utilize eco-friendly materials, biodegradable dyes, water recycling systems, and energy-efficient machines. Through our CSR initiatives focused on education, healthcare, and women empowerment, we positively impact over 10,000 individuals annually.
				</p>
			</div>
		</div>
	</section>

	<style>
		.page-hero {
			padding: 180px 0 100px;
			position: relative;
		}
		.page-hero h1 {
			font-size: 64px;
			margin-bottom: 20px;
		}
		.mx-auto {
			margin-left: auto;
			margin-right: auto;
		}
		.divider-maroon {
			background-color: var(--color-maroon);
		}
		.text-center {
			text-align: center;
		}
		
		/* Values Grid */
		.values-grid {
			display: flex;
			flex-wrap: wrap;
			gap: 30px;
			justify-content: center;
		}
		.value-box {
			background: rgba(255,255,255,0.05);
			border: 1px solid rgba(212, 175, 55, 0.2);
			padding: 40px;
			border-radius: 20px;
			width: calc(33.333% - 20px);
			min-width: 280px;
			transition: transform 0.3s;
		}
		.value-box:hover {
			transform: translateY(-5px);
			background: rgba(255,255,255,0.1);
		}
		.value-box h3 {
			font-size: 24px;
			margin-bottom: 15px;
		}
		.value-box p {
			font-family: var(--font-body);
			font-size: 15px;
			line-height: 1.6;
			opacity: 0.9;
		}

		/* Quote Block */
		.quote-container {
			text-align: center;
			max-width: 1000px;
			position: relative;
		}
		.quote-mark {
			font-family: var(--font-heading);
			font-size: 120px;
			color: var(--color-gold);
			opacity: 0.3;
			line-height: 0;
			position: absolute;
			top: 40px;
			left: 50%;
			transform: translateX(-50%);
		}
		.quote-text {
			font-size: 28px;
			line-height: 1.6;
			position: relative;
			z-index: 2;
			font-weight: 500;
		}

		/* Re-use grids from index */
		.excellence-grid, .machinery-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 80px;
			align-items: center;
		}
		.rounded-img { border-radius: 40px; width: 100%; }
		.small-divider { width: 80px; margin: 20px 0; }
		.exp-badge {
			position: absolute;
			bottom: -30px;
			left: -30px;
			background: white;
			padding: 25px 40px;
			border-radius: 20px;
			display: flex;
			gap: 20px;
			align-items: center;
			box-shadow: 0 10px 30px rgba(0,0,0,0.1);
			z-index: 5;
		}
		.exp-badge .count { font-size: 40px; font-weight: bold; font-family: var(--font-heading); color: var(--color-maroon); }
		.exp-badge .label { font-size: 12px; font-weight: bold; text-transform: uppercase; color: var(--color-maroon); }
		.callout-heading { text-align: center; margin-bottom: 60px; }
		.callout-heading h2 { font-size: 48px; }
		.callout-divider { width: 80px; height: 5px; background: var(--color-maroon); margin: 15px auto 0; border-radius: 10px; }
		.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
		.service-card { background: #f8f9fb; padding: 50px 40px; border-radius: 30px; transition: transform 0.3s; }
		.service-card:hover { transform: translateY(-5px); }
		.card-title { font-size: 28px; font-weight: 500; color: var(--color-navy); margin-bottom: 25px; }
		.card-line { width: 100%; height: 1.5px; background: var(--color-navy); margin-bottom: 30px; opacity: 0.8; }
		.card-body { font-family: var(--font-body); font-size: 15px; color: #666; line-height: 1.6; }

		@media (max-width: 1024px) {
			.excellence-grid, .machinery-grid, .services-grid { grid-template-columns: 1fr; gap: 40px; }
			.value-box { width: calc(50% - 15px); }
		}
		@media (max-width: 768px) {
			.page-hero { padding: 140px 0 60px; }
			.page-hero h1 { font-size: 36px; }
			.quote-text { font-size: 20px; }
			.value-box { width: 100%; }
			.exp-badge { left: 10px; bottom: -20px; }
		}
	</style>
</Layout>
