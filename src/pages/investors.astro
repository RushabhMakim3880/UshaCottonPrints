---
import Layout from "../layouts/Layout.astro";

const policies = [
    { title: "Policy for Determination of Materiality of Event", file: "1. Policy for Determination of Materiality of Event.pdf" },
    { title: "Code of Fair Disclosure of Unpublished Price Sensitive Information", file: "2. Code of Fair Disclosure of Unpblished Price Sensitive Information.pdf" },
    { title: "Code of Conduct for Directors & SMP", file: "3. Code-of-Conduct-fo-Directors-SMP.pdf" },
    { title: "Whistle Blower Policy", file: "4. Whistle Blower Policy.pdf" },
    { title: "Related Party Transactions Policy", file: "5. Related Party Transactions Policy.pdf" },
    { title: "Policy on Material Subsidiaries", file: "6. Policy on Material Subsidiaries.pdf" },
    { title: "Familiarization Programmes", file: "7. familiarization programmes.pdf" },
    { title: "Nomination and Remuneration Policy", file: "8. Nomination and Remuneration Policy.pdf" },
    { title: "CSR Policy", file: "9. CSR Policy.pdf" },
    { title: "Archival Policy", file: "10. Archival Policy.pdf" },
    { title: "Dividend Distribution Policy", file: "11. Dividend distribution policy.pdf" },
    { title: "Policy for Succession Planning for the Board of Directors and Senior Management Personnel", file: "12. Policy for succession planning for the Board of Directors and Senior Management Personnel.pdf" },
    { title: "Policy for Evaluation of Performance of Board of Directors", file: "13. Policy for Evaluation of performance of Board of Directors.pdf" },
    { title: "Insider Trading Policy", file: "14. Insider Trading Policy.pdf" },
    { title: "Preservation of Documents", file: "15. Preservation of documents.pdf" },
    { title: "Policy on Diversity of BOD", file: "16. Policy on Diversity of BOD.pdf" },
    { title: "Policy on Leak of UPSI", file: "17. Policy on leak of UPSI.pdf" },
    { title: "Code of Conduct", file: "18. Code of conduct.pdf" },
    { title: "Risk Management Policy", file: "19. Risk-Management-Policy.pdf" },
    { title: "POSH Policy", file: "20. POSH_Policy.pdf" }
];
---

<Layout title="Investors | Policies">
    <!-- Page Hero -->
    <section class="page-hero">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <p class="hero-subtitle">FINANCIALS</p>
            <h1 class="hero-title">Policies</h1>
        </div>
    </section>

    <!-- Policies Section -->
    <section class="section-padding bg-cream">
        <div class="container">
            <div class="policies-grid">
                {policies.map((policy) => (
                    <a href={`/policies/${policy.file}`} class="policy-card" download>
                        <div class="policy-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M14 2H6C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 2V8H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M12 18V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M9 15L12 18L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="policy-details">
                            <h3 class="policy-title">{policy.title}</h3>
                            <span class="download-text">Download PDF</span>
                        </div>
                    </a>
                ))}
            </div>

        </div>
    </section>

    <style>
        .page-hero {
            padding: 150px 0 100px;
            position: relative;
            background-image: url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 400px;
            display: flex;
            align-items: center;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to right, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 100%);
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-subtitle {
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 10px;
            font-family: var(--font-body);
        }

        .hero-title {
            color: #fff;
            font-size: 56px;
            font-weight: 300;
            margin: 0;
            font-family: var(--font-heading);
        }

        .policies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .policy-card {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .policy-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border-color: var(--color-maroon);
        }

        .policy-icon {
            color: var(--color-maroon);
            flex-shrink: 0;
            background: rgba(128, 0, 0, 0.05);
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .policy-card:hover .policy-icon {
            background: var(--color-maroon);
            color: #fff;
        }

        .policy-details {
            flex-grow: 1;
        }

        .policy-title {
            font-size: 16px;
            font-weight: 600;
            line-height: 1.4;
            color: var(--color-navy);
            margin-bottom: 8px;
            font-family: var(--font-body);
        }

        .download-text {
            font-size: 13px;
            color: #666;
            font-family: var(--font-body);
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .policy-card:hover .download-text {
            color: var(--color-maroon);
        }

        @media (max-width: 768px) {
            .page-hero {
                padding: 120px 0 60px;
                min-height: 300px;
            }
            .hero-title {
                font-size: 40px;
            }
            .policies-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
