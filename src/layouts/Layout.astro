---
import "../styles/global.css";
interface Props {
	title?: string;
}

const { title = "USHA COTTON PRINTS | Traditional Trust Since 1994" } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<!-- SS1: Header -->
		<header class="header transparent">
			<div class="container header-flex">
				<div class="logo-area">
					<a href="/">
						<img
							src="/images/logo.png"
							alt="Usha Logo"
							class="brand-logo"
						/>
					</a>
				</div>
				<nav class="nav-links">
					<a href="/about">About us</a>
					<a href="/printing">Printing</a>
					<a href="/products">Products</a>
					<a href="/contact">Contact</a>
				</nav>
				<div class="header-actions">
					<button class="mobile-menu-toggle" id="menuToggle">
						<span></span>
						<span></span>
					</button>
				</div>
			</div>
		</header>

		<!-- Mobile Nav Overlay -->
		<div class="mobile-nav-overlay" id="mobileNav">
			<button class="mobile-nav-close" id="closeMenu">✕</button>
			<a href="/about">About us</a>
			<a href="/printing">Printing</a>
			<a href="/products">Products</a>
			<a href="/contact">Contact</a>
		</div>

		<main>
			<slot />
		</main>

		<!-- SS8: Footer -->
		<footer class="footer-section bg-maroon text-white">
			<div class="container footer-flex">
				<div class="f-logo">
					<img
						src="/images/footer-logo.png"
						alt="Usha"
						class="logo-footer"
					/>
				</div>
				<nav class="f-nav">
					<div class="f-nav-col">
						<a href="/about">About us</a>
						<a href="/printing">Printing</a>
					</div>
					<div class="f-nav-col">
						<a href="/products">Products</a>
						<a href="#">Journey</a>
					</div>
				</nav>
				<div class="f-socials">
					<a href="#" class="icon-circ" aria-label="WhatsApp">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path></svg>
					</a>
					<a href="#" class="icon-circ" aria-label="Twitter">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.045 4.126H5.078z"></path></svg>
					</a>
					<a href="#" class="icon-circ" aria-label="Facebook">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
					</a>
					<a href="#" class="icon-circ" aria-label="Instagram">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
					</a>
					<a href="#" class="icon-circ" aria-label="LinkedIn">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v5.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"></path></svg>
					</a>
				</div>
				<div class="f-address">
					<p>
						Revenue Survey No.635p1, Plot No.8-12,<br /> Chaprajpur, Jetpur,
						Dist. Rajkot,<br /> Gujarat - 360370, India
					</p>
				</div>
			</div>
		</footer>

		<script>
			// 1. Header Scroll Logic
			const header = document.querySelector(".header");
			if (header) {
				window.addEventListener("scroll", () => {
					if (window.scrollY > 50) {
						header.classList.remove("transparent");
						header.classList.add("scrolled");
					} else {
						header.classList.add("transparent");
						header.classList.remove("scrolled");
					}
				});
			}

			// 2. Mobile Menu Toggle
			const menuToggle = document.getElementById("menuToggle");
			const closeMenu = document.getElementById("closeMenu");
			const mobileNav = document.getElementById("mobileNav");
			const mobileLinks = document.querySelectorAll(".mobile-nav-overlay a");

			menuToggle?.addEventListener("click", () => {
				mobileNav?.classList.add("active");
			});

			closeMenu?.addEventListener("click", () => {
				mobileNav?.classList.remove("active");
			});

			mobileLinks.forEach(link => {
				link.addEventListener("click", () => {
					mobileNav?.classList.remove("active");
				});
			});
		</script>

		<style>
			/* HEADER */
			.header {
				height: 80px;
				display: flex;
				align-items: center;
				position: fixed;
				width: 100%;
				top: 0;
				z-index: 1000;
				transition: all 0.3s ease;
				background: white;
				border-bottom: 1px solid #f0f0f0;
			}
			.header.scrolled {
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.header-flex {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
			}
			.brand-logo {
				width: 160px;
			}
			.nav-links {
				display: flex;
				gap: 50px;
			}
			.nav-links a {
				font-family: var(--font-body);
				font-weight: 600;
				font-size: 0.95rem;
				color: var(--color-navy);
				transition: color 0.3s;
				text-decoration: none;
			}
			.mobile-menu-toggle {
				display: none;
				background: none;
				border: none;
				width: 28px;
				gap: 8px;
				flex-direction: column;
				cursor: pointer;
			}
			.mobile-menu-toggle span {
				height: 1px;
				width: 100%;
				background: var(--color-navy);
				display: block;
			}

			/* MOBILE NAV OVERLAY */
			.mobile-nav-overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: var(--color-white);
				z-index: 2000;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 30px;
				transform: translateY(-100%);
				transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
			}
			.mobile-nav-overlay.active {
				transform: translateY(0);
			}
			.mobile-nav-overlay a {
				font-size: 24px;
				color: var(--color-navy);
				font-weight: 500;
				text-decoration: none;
			}
			.mobile-nav-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 30px;
				background: none;
				border: none;
				color: var(--color-navy);
			}

			/* FOOTER */
			.footer-section {
				padding: 80px 0;
			}
			.footer-flex {
				display: grid;
				grid-template-columns: 1.5fr 2fr 1.5fr 2fr;
				gap: 40px;
				align-items: start;
			}
			.logo-footer {
				width: 180px;
			}
			.f-nav {
				display: flex;
				gap: 60px;
			}
			.f-nav-col {
				display: flex;
				flex-direction: column;
				gap: 15px;
			}
			.f-nav a {
				font-weight: 500;
				font-size: 1rem;
				color: white;
			}
			.f-socials {
				display: flex;
				gap: 12px;
			}
			.icon-circ {
				width: 36px;
				height: 36px;
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 14px;
				transition: all 0.3s;
			}
			.icon-circ:hover {
				background: white;
			}
			.icon-circ:hover svg {
				fill: var(--color-maroon);
			}
			.f-address p {
				font-size: 14px;
				line-height: 1.8;
				opacity: 0.9;
				text-align: left;
			}

			/* ===== TABLET (max 1024px) ===== */
			@media (max-width: 1024px) {
				.nav-links { display: none !important; }
				.mobile-menu-toggle { display: flex !important; }
				.footer-flex {
					grid-template-columns: 1fr 1fr !important;
					gap: 40px !important;
				}
			}

			/* ===== MOBILE (max 768px) ===== */
			@media (max-width: 768px) {
				.footer-flex {
					grid-template-columns: 1fr !important;
					text-align: center;
					gap: 30px !important;
				}
				.logo-footer {
					margin: 0 auto;
				}
				.f-nav {
					flex-direction: row;
					justify-content: center;
					gap: 40px;
				}
				.f-socials {
					justify-content: center;
				}
				.f-address p {
					text-align: center;
				}
			}
			
			/* ===== SMALL MOBILE (max 480px) ===== */
			@media (max-width: 480px) {
				.brand-logo {
					width: 120px;
				}
			}
		</style>
	</body>
</html>
