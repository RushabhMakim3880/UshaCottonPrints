---
import "../styles/global.css";
interface Props {
	title?: string;
}

const { title = "USHA COTTON LIMITED | Traditional Trust Since 1994" } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts for Premium Look -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Upright:wght@400;500;600;700&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- SS1: Header -->
		<header class="header transparent">
			<div class="container header-flex">
				<div class="logo-area">
					<a href="/">
						<img
							src="/images/logo.png"
							alt="Usha Logo"
							class="brand-logo"
						/>
					</a>
				</div>
				<nav class="nav-links">
					<a href="/">Home</a>
					<a href="/about">About us</a>
					<a href="/printing">Printing</a>
					<a href="/products">Products</a>
					<a href="/investors">Investors</a>
					<a href="/contact">Contact</a>
				</nav>
				<div class="header-actions">
					<button class="mobile-menu-toggle" id="menuToggle">
						<span></span>
						<span></span>
					</button>
				</div>
			</div>
		</header>

		<!-- Mobile Nav Overlay -->
		<div class="mobile-nav-overlay" id="mobileNav">
			<button class="mobile-nav-close" id="closeMenu">✕</button>
			<a href="/">Home</a>
			<a href="/about">About us</a>
			<a href="/printing">Printing</a>
			<a href="/products">Products</a>
			<a href="/investors">Investors</a>
			<a href="/contact">Contact</a>
		</div>

		<main>
			<slot />
		</main>

		<!-- SS8: Footer -->
		<footer class="footer-section bg-maroon text-white">
			<div class="container footer-flex">
				<div class="f-logo">
					<img
						src="/images/footer-logo.png"
						alt="Usha"
						class="logo-footer"
					/>
				</div>
				<nav class="f-nav">
					<a href="/">Home</a>
					<a href="/about">About us</a>
					<a href="/printing">Printing</a>
					<a href="/products">Products</a>
					<a href="/investors">Investors</a>
					<a href="/contact">Contact</a>
				</nav>
				<div class="f-address">
					<p>
						Revenue Survey No.635p1, Plot No.8-12,<br /> Chaprajpur, Jetpur,
						Dist. Rajkot,<br /> Gujarat - 360370, India
					</p>
				</div>
			</div>
		</footer>

		<script>
			// 1. Header Scroll Logic
			const header = document.querySelector(".header");
			if (header) {
				window.addEventListener("scroll", () => {
					if (window.scrollY > 50) {
						header.classList.remove("transparent");
						header.classList.add("scrolled");
					} else {
						header.classList.add("transparent");
						header.classList.remove("scrolled");
					}
				});
			}

			// 2. Mobile Menu Toggle
			const menuToggle = document.getElementById("menuToggle");
			const closeMenu = document.getElementById("closeMenu");
			const mobileNav = document.getElementById("mobileNav");
			const mobileLinks = document.querySelectorAll(".mobile-nav-overlay a");

			menuToggle?.addEventListener("click", () => {
				mobileNav?.classList.add("active");
			});

			closeMenu?.addEventListener("click", () => {
				mobileNav?.classList.remove("active");
			});

			mobileLinks.forEach(link => {
				link.addEventListener("click", () => {
					mobileNav?.classList.remove("active");
				});
			});
		</script>

		<style>
			/* HEADER */
			.header {
				height: 80px;
				display: flex;
				align-items: center;
				position: fixed;
				width: 100%;
				top: 0;
				z-index: 1000;
				transition: all 0.3s ease;
				background: white;
				border-bottom: 1px solid #f0f0f0;
			}
			.header.scrolled {
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}
			.header-flex {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
			}
			.logo-area {
				flex: 1;
				display: flex;
				justify-content: flex-start;
			}
			.header-actions {
				flex: 1;
				display: flex;
				justify-content: flex-end;
			}
			.brand-logo {
				width: 160px;
			}
			.nav-links {
				display: flex;
				gap: 50px;
				justify-content: center;
			}
			.nav-links a {
				font-family: var(--font-body);
				font-weight: 600;
				font-size: 0.95rem;
				color: var(--color-navy);
				transition: color 0.3s;
				text-decoration: none;
			}
			.mobile-menu-toggle {
				display: none;
				background: none;
				border: none;
				width: 28px;
				gap: 8px;
				flex-direction: column;
				cursor: pointer;
			}
			.mobile-menu-toggle span {
				height: 1px;
				width: 100%;
				background: var(--color-navy);
				display: block;
			}

			/* MOBILE NAV OVERLAY */
			.mobile-nav-overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: var(--color-white);
				z-index: 2000;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 30px;
				transform: translateY(-100%);
				transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
			}
			.mobile-nav-overlay.active {
				transform: translateY(0);
			}
			.mobile-nav-overlay a {
				font-size: 24px;
				color: var(--color-navy);
				font-weight: 500;
				text-decoration: none;
			}
			.mobile-nav-close {
				position: absolute;
				top: 20px;
				right: 20px;
				font-size: 30px;
				background: none;
				border: none;
				color: var(--color-navy);
			}

			/* FOOTER */
			.footer-section {
				padding: 80px 0;
			}
			.footer-flex {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 40px;
				flex-wrap: wrap;
			}
			.logo-footer {
				width: 180px;
				filter: brightness(0) invert(1);
			}
			.f-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 40px;
			}
			.f-nav a {
				font-weight: 500;
				font-size: 1rem;
				color: white;
			}

			.f-address {
				text-align: right;
			}
			.f-address p {
				font-size: 14px;
				line-height: 1.8;
				opacity: 0.9;
				text-align: right;
				margin: 0;
			}

			/* ===== TABLET (max 1024px) ===== */
			@media (max-width: 1024px) {
				.nav-links { display: none !important; }
				.mobile-menu-toggle { display: flex !important; }
				.footer-flex {
					justify-content: center;
				}
				.f-address, .f-address p {
					text-align: center;
				}
			}

			/* ===== MOBILE (max 768px) ===== */
			@media (max-width: 768px) {
				.footer-flex {
					flex-direction: column;
					text-align: center;
					gap: 30px;
				}
				.logo-footer {
					margin: 0 auto;
				}
				.f-nav {
					flex-direction: row;
					justify-content: center;
					gap: 40px;
					width: 100%;
				}
				.f-address p {
					text-align: center;
				}
			}
			
			/* ===== SMALL MOBILE (max 480px) ===== */
			@media (max-width: 480px) {
				.brand-logo {
					width: 120px;
				}
			}
		</style>
	</body>
</html>
